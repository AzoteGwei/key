<configuration>
    <!-- disables logback configuration messages on start up -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <!--
        Everything goes to stderr on purpose. stdout is reserved: the client CLI promises that
        its JSON mode writes nothing but a single JSON object there, and a future stdio transport
        would need stdout to carry protocol frames only. Keeping logs off stdout from the start
        avoids having to retrofit that later.
    -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>[%date{HH:mm:ss.SSS}] %-5level %logger{0} - %msg%ex%n</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
